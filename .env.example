# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used for canonical links, sitemap, OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project settings → API Keys (new key format works: sb_publishable_ / sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon JWT. Safe in the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or legacy service_role JWT. SERVER ONLY — bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Used by createAdminClient() and scripts/e2e-auth.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email) — Phase "emails"
RESEND_API_KEY=
EMAIL_FROM="Unisphere <no-reply@example.org>"

# ORCID OAuth — deferred (ORCID iD is a validated profile field for now)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ROR institution suggestions (optional) — free client ID from https://ror.org for higher API rate limits
ROR_CLIENT_ID=
