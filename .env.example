# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used for canonical links, sitemap, OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — use only in trusted server code (admin tasks, crawler access).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email) — Phase "emails"
RESEND_API_KEY=
EMAIL_FROM="Unisphere <no-reply@example.org>"

# ORCID OAuth (optional) — Phase "auth"
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
